# =============================================================
# Server environment variables
# Copy this file to server/.env and fill in your values.
# =============================================================

# ── App ───────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB ──────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_me

# ── CORS / Client URLs ────────────────────────────────────────
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ── Frontend (client/.env) ────────────────────────────────────
# Set these in client/.env (not server/.env)
# VITE_BACKEND_URL=https://your-backend.example.com
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key

# ── Email (SMTP via Nodemailer) ───────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
FROM_NAME=MERN Starter
FROM_EMAIL=noreply@example.com

# ── Cloudinary (optional — for avatar uploads) ────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_KEY=your_api_key
CLOUDINARY_SECRET=your_api_secret

# ---- Clerk (optional — for authentication) ─────────────────────────────
CLERK_SECRET_KEY=YOUR_SECRET_KEY
